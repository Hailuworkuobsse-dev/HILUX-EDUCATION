# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Public URL of this API (used to build absolute URLs for exports, dev checkouts)
API_PUBLIC_URL=http://localhost:4000

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=mysql://examprep:examprep@localhost:3306/examprep

# ─── Auth ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Business ──────────────────────────────────────────────
TRIAL_DAYS=90
PRICE_PER_COURSE=150
CURRENCY=ETB

# ─── Payment providers (production only — leave empty in dev) ────
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
CBE_MERCHANT_ID=
CBE_API_KEY=
CBE_API_SECRET=
CHAPA_SECRET_KEY=

# ─── Notifications (production only — leave empty in dev) ────
# SMS (Afromessage)
SMS_API_URL=https://api.afromessage.com/api/send
SMS_API_KEY=
SMS_FROM_ID=

# Email (Resend)
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=noreply@examprep.local
