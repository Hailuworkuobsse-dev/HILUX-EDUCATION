# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=mysql://examprep:examprep@localhost:3306/examprep

# ─── Auth ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars
